<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.template.MainController" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Tabela Nutricional (NUTRI CRUD)"/>

   <GridPane hgap="10.0" vgap="10.0">
      <columnConstraints>
         <ColumnConstraints minWidth="100.0" prefWidth="120.0"/>
         <ColumnConstraints hgrow="ALWAYS"/>
      </columnConstraints>

      <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Alimento:"/>
      <TextField fx:id="txtAlimento" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Ex: Maçã"/>

      <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Calorias:"/>
      <TextField fx:id="txtCalorias" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="0.0"/>

      <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Natural:"/>
      <HBox spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
         <RadioButton fx:id="rbtnNaturalSim" text="Sim"/>
         <RadioButton fx:id="rbtnNaturalNao" text="Não"/>
      </HBox>
   </GridPane>

   <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <Button fx:id="btnSalvar" onAction="#btnSalvarAction" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar"/>
      <Button fx:id="btnListar" onAction="#btnListarAction" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold;" text="Listar"/>
      <Button fx:id="btnAlterar" disable="true" onAction="#btnAlterarAction" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;" text="Alterar"/>
      <Button fx:id="btnDeletar" disable="true" onAction="#btnDeletarAction" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;" text="Deletar"/>
   </HBox>

   <Label fx:id="lblStatus" style="-fx-text-fill: gray;"/>

   <TableView fx:id="tblTabelaNutricional" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
         <TableColumn fx:id="colAlimento" prefWidth="200.0" text="Alimento"/>
         <TableColumn fx:id="colCalorias" prefWidth="120.0" text="Calorias"/>
         <TableColumn fx:id="colNatural" prefWidth="100.0" text="Natural"/>
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
      </columnResizePolicy>
   </TableView>

</VBox>